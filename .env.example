# Copie ce fichier en .env et remplis-le. Ne publie jamais le .env.

# --- Mail : boite Gmail dediee au cadre (mot de passe d'application Google) ---
GMAIL_USER=
GMAIL_PASS=
MAIL_ENABLED=1
CHECK_INTERVAL=60

# --- Interface web ---
WEB_AUTH=1
WEB_USER=admin
WEB_PORT=8080
# Vides au premier demarrage : la cle de session et le mot de passe sont generes.
# Le mot de passe genere s'affiche une fois dans le journal du service, puis seul
# son hash est conserve dans ce fichier.
SECRET_KEY=
WEB_PASS_HASH=

# --- Telegram ---
TELEGRAM_ENABLED=0
TELEGRAM_TOKEN=
# Code a donner aux personnes autorisees a envoyer des photos
TELEGRAM_CODE=
# Codes a usage unique des gestionnaires, separes par des virgules
TELEGRAM_ADMIN_CODES=
# Compte Telegram du responsable : ses droits sont permanents
TELEGRAM_OWNER_ID=
TELEGRAM_OWNER_NAME=
# 1 = envoyer chaque nouvelle photo aux gestionnaires
ADMIN_NOTIFY=0

# --- Diaporama ---
SLIDE_DELAY=8
# recent ou random
SLIDE_ORDER=recent
# mixte, flou, recadre ou bandes
DISPLAY_MODE=mixte
# Exemple : 1920x1080. Vide = detection automatique avec xrandr
DISPLAY_SIZE=
THUMB_SIZE=320
# Dossier des photos. Par defaut : ~/photos
# PHOTO_DIR=/home/pi/photos
